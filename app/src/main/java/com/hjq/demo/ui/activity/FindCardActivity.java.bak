                    return 0;
                }*/
            });

            int kernelProcessResult = mEmvBinderService.apiEmvKernelProcess(emvParamByte);
            Log.e(TAG, "kernelProcessResult-------> " + kernelProcessResult);

            //只在认证的时候使用,第三方集成请忽略此步骤
