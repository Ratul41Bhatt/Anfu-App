    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!--
      Read by the App Information screen for the terminal serial number and the
      SIM operator. Both degrade to "NOT AVAILABLE" without it, and it is a
      runtime permission, so on a build that is not privileged the operator has
      to grant it before those two rows say anything.
    -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!--
      The App Information screen runs the *2# self-number USSD to read each
      SIM's own MSISDN. sendUssdRequest requires CALL_PHONE. Declining is
      handled - the rows say so and nothing else on the screen depends on it.
    -->
    <uses-permission android:name="android.permission.CALL_PHONE" />


