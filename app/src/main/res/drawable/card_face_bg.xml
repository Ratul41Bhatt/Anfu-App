<?xml version="1.0" encoding="utf-8"?>
<!-- The card face. Deep blue, the bank's colour, with a corner radius that
     matches a real card's proportions at this size. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="#1B3A6B"
        android:centerColor="#14284D"
        android:endColor="#0E1C36"
        android:type="linear" />
    <corners android:radius="14dp" />
</shape>
