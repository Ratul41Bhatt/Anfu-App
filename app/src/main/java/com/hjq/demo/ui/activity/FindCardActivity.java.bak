                                resultHolder[0] = -1;
                            }
                            latch.countDown();
                        }
                    });

                    try {
                        latch.await();
                    } catch (InterruptedException e) {
                        e.printStackTrace();
                    }

                    return resultHolder[0];
                }
            });

            /**
             * Cardholder ID verification(持卡人认证确认)
             * 注意：只有PBOC的才有持卡人认证确认
             */
