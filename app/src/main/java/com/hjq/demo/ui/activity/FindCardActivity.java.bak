    private static class RLine {
        final String left, right;
        final int size, flags;
        RLine(String left, String right, int size, int flags) {
            this.left = left == null ? "" : left;
            this.right = right == null ? "" : right;
            this.size = size;
            this.flags = flags;
        }
    }

