<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E0E0E0"
    android:orientation="vertical"
    android:weightSum="4" >

    <View
        style="@style/kb_view_style"
        android:layout_width="wrap_content" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:layout_marginLeft="1dp"
        android:weightSum="4" >

        <TextView
            android:id="@+id/kb_bt_one"
            style="@style/kb_tv_style_horizontal"
            android:text="1" />

        <TextView
            android:id="@+id/kb_bt_two"
            style="@style/kb_tv_style_horizontal"
            android:text="2" />

        <TextView
            android:id="@+id/kb_bt_three"
            style="@style/kb_tv_style_horizontal"
            android:text="3" />

        <TextView
            android:id="@+id/kb_bt_cancel"
            style="@style/kb_tv_style_horizontal"
            android:text="@string/amount_backspace" />
    </LinearLayout>

    <View style="@style/kb_view_style" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginLeft="1dp">

        <TextView
            android:id="@+id/kb_bt_four"
            style="@style/kb_tv_style_horizontal"
            android:text="4" />

        <TextView
            android:id="@+id/kb_bt_five"
            style="@style/kb_tv_style_horizontal"
            android:text="5" />

        <TextView
            android:id="@+id/kb_bt_six"
            style="@style/kb_tv_style_horizontal"
            android:text="6" />

        <TextView
            android:id="@+id/kb_bt_clear"
            style="@style/kb_tv_style_horizontal"
            android:text="@string/amount_clear" />
    </LinearLayout>

    <View style="@style/kb_view_style" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:orientation="horizontal"
        android:layout_marginLeft="1dp"
        android:weightSum="4" >

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3"
            android:orientation="vertical"
            android:weightSum="2" >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" >

                <TextView
                    android:id="@+id/kb_bt_seven"
                    style="@style/kb_tv_style_horizontal"
                    android:text="7"/>

                <TextView
                    android:id="@+id/kb_bt_eight"
                    style="@style/kb_tv_style_horizontal"
                    android:text="8" />

                <TextView
                    android:id="@+id/kb_bt_nine"
                    style="@style/kb_tv_style_horizontal"
                    android:text="9" />
            </LinearLayout>

            <View style="@style/kb_view_style"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <TextView
                    android:id="@+id/kb_bt_zero"
                    style="@style/kb_tv_style_horizontal"
                    android:text="0" />
            </LinearLayout>
        </LinearLayout>


        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical" >

<!--            style="@style/kb_tv_style_vertical"-->
            <TextView
                android:id="@+id/kb_bt_ensure"
                android:text="@string/amount_confirm"
                android:textColor="@color/white"
                android:layout_marginRight="0dp"
                android:layout_height="0dp"
                android:layout_width="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:textSize="20sp"
                android:clickable="true"
                android:background="@color/grey2"/>

        </LinearLayout>
    </LinearLayout>

    <View style="@style/kb_view_style" />

</LinearLayout>