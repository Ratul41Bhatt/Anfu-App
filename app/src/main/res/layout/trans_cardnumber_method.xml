<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_activity"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:id="@+id/ll_trans_type"
    tools:context=".ui.activity.SelectCardnoMethodActivity">

    <com.hjq.bar.TitleBar
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_48"
        android:background="@color/common_transparent_color"
        app:leftIcon="@drawable/arrows_left"
        app:leftIconHeight="@dimen/dp_18"
        app:leftIconWidth="@dimen/dp_18"
        app:lineVisible="false"
        app:titleColor="@color/white"
        app:titleSize="@dimen/sp_16" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0px"
        android:layout_weight="1"
        android:background="@color/common_bg_color"
        android:clickable="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/card_number_method"
            android:textSize="35sp"
            android:gravity="center"
            android:layout_marginTop="@dimen/dp_25"/>

        <TextView
            android:id="@+id/tv_cardnumber_amount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/card_number_amount"
            android:textSize="28sp"
            android:gravity="center"
            android:layout_marginTop="@dimen/dp_15"/>

        <com.hjq.widget.layout.SettingBar
            android:id="@+id/sb_cardnumber_insert"
            android:layout_width="@dimen/dp_300"
            android:layout_height="@dimen/dp_60"
            android:layout_marginTop="@dimen/dp_15"
            android:background="@drawable/rounded_rectangle_shadow"
            app:bar_rightText="@string/card_number_insert"
            app:bar_rightTextSize="25sp"
            app:bar_rightDrawable="@drawable/arrows_right_ic" />

        <com.hjq.widget.layout.SettingBar
            android:id="@+id/sb_cardnumber_manual"
            android:layout_width="@dimen/dp_300"
            android:layout_height="@dimen/dp_60"
            android:layout_marginTop="@dimen/dp_10"
            android:background="@drawable/rounded_rectangle_shadow"
            app:bar_rightText="@string/card_number_manual"
            app:bar_rightTextSize="25sp"
            app:bar_rightDrawable="@drawable/arrows_right_ic" />

    <!--
        <Button
            android:textSize="@dimen/sp_25"
            android:layout_width="@dimen/dp_320"
            android:layout_height="@dimen/dp_60"
            android:text="@string/card_number_insert"
            android:layout_marginTop="@dimen/sp_25"
            />

        <Button
            android:textSize="@dimen/sp_25"
            android:layout_width="@dimen/dp_320"
            android:layout_height="@dimen/dp_60"
            android:text="@string/card_number_manual"
            android:layout_marginTop="@dimen/sp_20"/>
    -->

    </LinearLayout>

</LinearLayout>