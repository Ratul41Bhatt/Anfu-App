<?xml version="1.0" encoding="utf-8"?>
<!--
  Password entry. Replaces the bare AlertDialog + naked EditText, which on this
  terminal drew a hairline underline and 14sp text roughly the size of a
  fingernail.

  Blue header, a card, six large dots that fill as digits are typed, and the
  two actions as full-height coloured buttons - red CANCEL on the LEFT, green
  CONFIRM on the RIGHT - so the operator is aiming at a target rather than at
  a word.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_pw_card"
    android:orientation="vertical">

    <TextView
        android:id="@+id/pw_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_pw_header"
        android:gravity="center"
        android:paddingTop="22dp"
        android:paddingBottom="22dp"
        android:text="PASSWORD"
        android:textColor="#FFFFFF"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/pw_prompt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="20dp"
        android:text="ENTER PASSWORD"
        android:textColor="#5C6B85"
        android:textSize="20sp" />

    <!-- The dots the operator watches. The real value lives in the invisible
         EditText below, so the soft keypad and the password masking are the
         platform's rather than hand-rolled. -->
    <TextView
        android:id="@+id/pw_dots"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="14dp"
        android:paddingBottom="18dp"
        android:letterSpacing="0.25"
        android:text=""
        android:textColor="#1B4FCB"
        android:textSize="42sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/pw_value"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:alpha="0"
        android:background="@null"
        android:inputType="numberPassword"
        android:maxLength="12" />

    <TextView
        android:id="@+id/pw_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingBottom="6dp"
        android:textColor="#D32F2F"
        android:textSize="20sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:background="#D6DEEC" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <Button
            android:id="@+id/pw_cancel"
            android:layout_width="0dp"
            android:layout_height="88dp"
            android:layout_weight="1"
            android:layout_marginRight="8dp"
            android:background="@drawable/bg_pw_cancel"
            android:text="CANCEL"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/pw_confirm"
            android:layout_width="0dp"
            android:layout_height="88dp"
            android:layout_weight="1"
            android:layout_marginLeft="8dp"
            android:background="@drawable/bg_pw_confirm"
            android:text="CONFIRM"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
