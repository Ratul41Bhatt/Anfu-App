<?xml version="1.0" encoding="utf-8"?>
<!-- Continue. Green rather than blue, matching btn_confirm_green (#1E8E3E /
     #14682F) so the go-ahead is the same colour everywhere in the app - the
     card-confirm dialog already uses it. Blue is the screen's own accent and
     is on the badge, the amount panel and the backspace key; the one button
     that commits the sale should not be another of them. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#A8D4B6" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#14682F" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1E8E3E" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
