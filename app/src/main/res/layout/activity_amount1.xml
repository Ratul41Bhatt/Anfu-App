<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:focusableInTouchMode="false"
    android:focusable="false"
    android:enabled="false"
    android:layout_height="match_parent"
    android:background="@drawable/bg_activity"
    android:orientation="vertical"
    tools:context=".ui.activity.AmountActivity">

    <com.hjq.bar.TitleBar
        android:id="@+id/amount_title"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_48"
        android:background="@color/common_transparent_color"
        app:leftIcon="@drawable/arrows_left"
        app:leftIconHeight="@dimen/dp_18"
        app:leftIconWidth="@dimen/dp_18"
        app:title="@string/cardsale_title"
        app:titleColor="@color/white"
        app:titleSize="@dimen/sp_16" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:orientation="vertical"
        android:weightSum="7">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="4"
            android:orientation="vertical">

            <TextView
                android:id="@+id/am_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_30"
                android:layout_marginTop="@dimen/dp_29"
                android:layout_marginRight="@dimen/dp_30"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:text="@string/cardsale_transa_amount"
                android:textColor="@color/common_textcolor_2D"
                android:textSize="@dimen/sp_14" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_18">

                <TextView
                    android:id="@+id/txtIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignTop="@id/am_amount"
                    android:layout_alignBottom="@id/am_amount"
                    android:layout_marginLeft="@dimen/dp_25"
                    android:gravity="center"
                    android:text="TK."
                    android:textColor="@color/common_textcolor_1A"
                    android:textSize="@dimen/sp_36"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/am_amount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="@dimen/dp_25"
                    android:background="@null"
                    android:enabled="false"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:text="0.00"
                    android:gravity="left|center_vertical"
                    android:maxLength="8"
                    android:textColor="@color/common_textcolor_1A"
                    android:textSize="@dimen/sp_40"
                    android:layout_toRightOf="@id/txtIcon"/>

                <View
                    style="@style/HorizontalLineStyle3"
                    android:layout_alignLeft="@id/txtIcon"
                    android:layout_alignRight="@id/am_amount"
                    android:layout_below="@id/am_amount"
                    android:layout_marginTop="@dimen/dp_8"/>

            </RelativeLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/amount_pin_type"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="3"
            android:orientation="vertical">

            <com.hjq.demo.ui.view.KeyBoardView
                android:id="@+id/am_kb_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

            </com.hjq.demo.ui.view.KeyBoardView>
        </LinearLayout>

    </LinearLayout>
</LinearLayout>