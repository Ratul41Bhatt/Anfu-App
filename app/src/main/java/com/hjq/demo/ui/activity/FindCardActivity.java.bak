                    try {
                        latch.await();
                    } catch (InterruptedException e) {
                        e.printStackTrace();
                    }
                    return resultHolder[0];
                }
            });

            // 应用选择 Application Selection(弹框显示AID，供选择)
            mEmvBinderService.apiSetEmvAppConfirmCallBack(new ISdkKernelEmvAppCallback.Stub() {
