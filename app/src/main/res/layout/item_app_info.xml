<?xml version="1.0" encoding="utf-8"?>
<!-- One fact on the App Information screen: label left, value right.

     Sized for the AF980's screen rather than a phone's. At 13sp on a 5.5"
     720p panel this list was legible only to someone already holding the
     terminal up to their face, and it is read across a counter. The value
     stays monospace so the columns line up down the page; it is a point
     smaller than the label because a monospace face sets wider at the same
     size. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingBottom="11dp"
    android:paddingLeft="12dp"
    android:paddingRight="12dp"
    android:paddingTop="11dp">

    <TextView
        android:id="@+id/item_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="#5A6172"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/item_value"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.32"
        android:fontFamily="monospace"
        android:gravity="end"
        android:textColor="#100567"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
