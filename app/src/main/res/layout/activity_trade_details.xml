<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_activity"
    tools:context=".ui.activity.ShowTradeDetailsActivity">

    <com.hjq.bar.TitleBar
        android:id="@+id/cardno_title"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_48"
        android:background="@color/common_transparent_color"
        app:leftIcon="@drawable/arrows_left"
        app:leftIconHeight="@dimen/dp_18"
        app:leftIconWidth="@dimen/dp_18"
        app:title="@string/trans_order"
        app:titleColor="@color/white"
        app:titleSize="@dimen/sp_16" />

    <ListView
        android:id="@+id/lv_details"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <include
        android:id="@+id/emptyview"
        layout="@layout/empty_list_layout"/>

</LinearLayout>