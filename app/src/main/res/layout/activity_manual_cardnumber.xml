<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:focusableInTouchMode="false"
    android:focusable="false"
    android:enabled="false"
    android:layout_height="match_parent"
    android:background="@drawable/bg_activity"
    android:orientation="vertical"
    tools:context=".ui.activity.ManualPunchActivity">

    <com.hjq.bar.TitleBar
        android:id="@+id/cardno_title"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_48"
        android:background="@color/common_transparent_color"
        app:leftIcon="@drawable/arrows_left"
        app:leftIconHeight="@dimen/dp_18"
        app:leftIconWidth="@dimen/dp_18"
        app:title="@string/manual_punch"
        app:titleColor="@color/white"
        app:titleSize="@dimen/sp_16" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:orientation="vertical"
        android:weightSum="7">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="4"
            android:orientation="vertical">

            <EditText
                android:id="@+id/et_card_number"
                android:layout_width="@dimen/dp_310"
                android:layout_height="@dimen/dp_60"
                android:layout_gravity="center"
                android:background="@drawable/rounded_rectangle"
                android:hint="@string/manual_enter_card_number"
                android:paddingLeft="@dimen/dp_10"
                android:gravity="left|center_vertical"
                android:textSize="@dimen/sp_22"
                android:textColor="@color/common_textcolor_1A"
                android:singleLine="true"
                android:cursorVisible="true"
                android:maxLength="23"
                android:layout_marginTop="@dimen/dp_25" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_customer_present"
                style="@style/RoundButtonStyle"
                android:layout_width="@dimen/dp_310"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/dp_20"
                android:textSize="@dimen/sp_22"
                android:text="@string/manual_customer_present"
                />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_customer_not_present"
                style="@style/RoundButtonStyle"
                android:layout_width="@dimen/dp_310"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/dp_20"
                android:textSize="@dimen/sp_22"
                android:text="@string/manual_customer_not_present"
                />

            <RelativeLayout
                android:layout_width="@dimen/dp_310"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/dp_10"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_cardno_cancel"
                    style="@style/RoundButtonStyle"
                    android:layout_width="@dimen/dp_140"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/dp_10"
                    android:textSize="@dimen/sp_22"
                    android:text="@string/common_cancel"
                    />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_cardno_continue"
                    style="@style/RoundButtonStyle"
                    android:layout_width="@dimen/dp_140"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/dp_10"
                    android:layout_alignParentRight="true"
                    android:textSize="@dimen/sp_22"
                    android:text="@string/common_continue"
                    />

            </RelativeLayout>

        </LinearLayout>


        <LinearLayout
            android:id="@+id/cardno_pin_type"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="3"
            android:orientation="vertical">

            <com.hjq.demo.ui.view.KeyBoardView
                android:id="@+id/cardno_kb_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

            </com.hjq.demo.ui.view.KeyBoardView>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>

