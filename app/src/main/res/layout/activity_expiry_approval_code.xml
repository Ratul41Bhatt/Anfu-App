<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:focusableInTouchMode="false"
    android:focusable="false"
    android:enabled="false"
    android:layout_height="match_parent"
    android:background="@drawable/bg_activity"
    android:orientation="vertical"
    tools:context=".ui.activity.ManualExpiryApprovalActivity">

    <com.hjq.bar.TitleBar
        android:id="@+id/amount_title"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_48"
        android:background="@color/common_transparent_color"
        app:leftIcon="@drawable/arrows_left"
        app:leftIconHeight="@dimen/dp_18"
        app:leftIconWidth="@dimen/dp_18"
        app:title="@string/manual_offline_final"
        app:titleColor="@color/white"
        app:titleSize="@dimen/sp_16" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:orientation="vertical"
        android:weightSum="7">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="4"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_cardno"
                android:layout_marginTop="@dimen/dp_20"
                android:layout_width="@dimen/dp_320"
                android:layout_height="@dimen/dp_50"
                android:layout_gravity="center"
                android:textSize="@dimen/sp_17"
                android:gravity="center_vertical"
                android:text="@string/manual_card_no"
                android:paddingLeft="@dimen/dp_12"
                android:background="@drawable/rounded_rectangle"/>
            <View
                style="@style/HorizontalLineStyle"
                android:layout_marginHorizontal="@dimen/dp_20" />

            <com.hjq.widget.view.RegexEditText
                android:id="@+id/pet_expiry"
                style="@style/EditTextStyle"
                android:layout_width="@dimen/dp_320"
                android:layout_height="@dimen/dp_50"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/dp_10"
                android:background="@drawable/rounded_rectangle"
                android:drawableStart="@drawable/ic_date_foreground"
                android:drawablePadding="@dimen/dp_1"
                android:hint="@string/manual_expiry"
                android:paddingHorizontal="10dp"
                android:paddingVertical="@dimen/dp_10"
                android:singleLine="true"
                android:maxLength="4"
                android:textSize="@dimen/sp_17" />

            <View
                style="@style/HorizontalLineStyle"
                android:layout_marginHorizontal="@dimen/dp_20" />

            <com.hjq.widget.view.RegexEditText
                android:id="@+id/pet_approval_code"
                style="@style/EditTextStyle"
                android:layout_width="@dimen/dp_320"
                android:layout_height="@dimen/dp_50"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/dp_10"
                android:background="@drawable/rounded_rectangle"
                android:drawableStart="@drawable/ic_approval_foreground"
                android:drawablePadding="@dimen/dp_1"
                android:hint="@string/manual_approval_code"
                android:paddingHorizontal="10dp"
                android:paddingVertical="@dimen/dp_10"
                android:singleLine="true"
                android:maxLength="6"
                android:textSize="@dimen/sp_17" />

            <View
                style="@style/HorizontalLineStyle"
                android:layout_marginHorizontal="@dimen/dp_20" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_manual_pay"
                style="@style/ButtonStyle"
                android:layout_width="@dimen/dp_300"
                android:layout_height="@dimen/dp_40"
                android:layout_marginHorizontal="@dimen/dp_30"
                android:layout_marginVertical="@dimen/dp_20"
                android:text="@string/manual_pay" />

        </LinearLayout>


        <LinearLayout
            android:id="@+id/expiry_pin_type"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="3"
            android:orientation="vertical">

            <com.hjq.demo.ui.view.KeyBoardView
                android:id="@+id/expiry_kb_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

            </com.hjq.demo.ui.view.KeyBoardView>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
