<?xml version="1.0" encoding="UTF-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.activity.ScanByHWActivity">

    <TextureView
        android:id="@+id/texture_preview_camera"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/scan_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:scaleType="centerCrop"
            android:src="@drawable/scan_line" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="@dimen/dp_150"
            android:gravity="center"
            android:text="@string/scan_tip"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold" />

<!--        <ImageView-->
<!--            android:id="@+id/flush_btn"-->
<!--            android:layout_width="48dp"-->
<!--            android:layout_height="48dp"-->
<!--            android:layout_alignParentBottom="true"-->
<!--            android:layout_centerHorizontal="true"-->
<!--            android:layout_marginBottom="@dimen/dp_40"-->
<!--            android:gravity="center"-->
<!--            android:src="@drawable/flashlight_off"-->
<!--            android:visibility="gone" />-->


        <!-- 弱光提示，手电筒打开 -->
        <LinearLayout
            android:id="@+id/ll_weak_light"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="@dimen/dp_40"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:id="@+id/iv_flash_lamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_flashlight_close" />

            <TextView
                android:id="@+id/tv_weak_light_tips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="轻点照亮"
                android:textColor="@android:color/white" />

        </LinearLayout>
    </RelativeLayout>

    <!-- 标题栏 -->
    <com.hjq.bar.TitleBar
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_48"
        android:background="@color/common_transparent_color"
        app:leftIcon="@drawable/arrows_left"
        app:leftIconHeight="@dimen/dp_18"
        app:leftIconWidth="@dimen/dp_18"
        app:lineVisible="false"
        app:title="@string/scan_qr_code"
        app:titleColor="@color/white"
        app:titleSize="@dimen/sp_16" />

