<?xml version="1.0" encoding="utf-8"?>
<!--
  The card face, on its own so exactly one copy of it exists.

  It is drawn twice: once inside dialog_card_confirm, which asks "is this the
  card in your hand?", and once at the top of the PIN pad, which asks for the
  PIN of that same card. Those two screens follow one another in a sale, so the
  card must not change shape between them - which it will the moment there are
  two copies of this markup to keep in step. dialog_card_confirm includes this
  file; DynamicPinPad inflates it. Edit the card here and both follow.

  Chip top left, number across the middle, expiry top right, scheme mark bottom
  right - laid out like the object the operator is holding.

  The sheen is the FrameLayout's FOREGROUND, not a child View. As a child with
  layout_height="match_parent" inside a wrap_content FrameLayout it measured
  against the whole screen, so the card grew into a full-screen panel. A
  foreground is painted over the view without taking part in measuring it.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/card_face_bg"
    android:foreground="@drawable/card_face_sheen">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- issuer left, expiry hard right, on the top line -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/cc_issuer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:letterSpacing="0.06"
                android:maxLines="2"
                android:paddingEnd="8dp"
                android:paddingRight="8dp"
                android:textColor="#CFE0FF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.1"
                    android:text="VALID THRU"
                    android:textColor="#8FA9D4"
                    android:textSize="8sp" />

                <TextView
                    android:id="@+id/cc_expiry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="**/**"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- the chip, where it sits on a real card -->
        <ImageView
            android:id="@+id/cc_chip"
            android:layout_width="46dp"
            android:layout_height="36dp"
            android:layout_marginTop="12dp"
            android:contentDescription="@null"
            android:src="@drawable/emv_chip" />

        <TextView
            android:id="@+id/cc_pan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="21sp"
            android:textStyle="bold" />

        <!-- entry method left, scheme mark hard right, on the bottom line -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/cc_entry"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:letterSpacing="0.08"
                android:textColor="#8FA9D4"
                android:textSize="10sp" />

            <ImageView
                android:id="@+id/cc_brand_icon"
                android:layout_width="46dp"
                android:layout_height="30dp"
                android:contentDescription="@null"
                android:scaleType="fitEnd"
                android:visibility="gone" />

            <TextView
                android:id="@+id/cc_brand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.06"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
