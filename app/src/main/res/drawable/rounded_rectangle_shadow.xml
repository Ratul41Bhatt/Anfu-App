<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
<!-- 定义阴影 -->
<item>
    <shape android:shape="rectangle">
        <solid android:color="#10000000"/> <!-- 半透明黑色 -->
        <corners android:radius="@dimen/dialog_ui_round_size"/> <!-- 圆角 -->
        <padding
            android:left="1dp"
            android:top="2dp"
            android:bottom="5dp"
            android:right="5dp"/>
    </shape>
</item>
<!-- 定义EditText背景 -->
<item android:bottom="2dp" android:left="2dp"> <!-- 移动以覆盖阴影 -->
    <shape android:shape="rectangle">
        <solid android:color="#FFFFFF"/> <!-- 白色背景 -->
        <corners android:radius="@dimen/dialog_ui_round_size"/> <!-- 圆角 -->
    </shape>
</item>
</layer-list>
