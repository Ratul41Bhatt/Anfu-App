<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_activity"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:id="@+id/ll_trans_type"
    tools:context=".ui.activity.SelectTransTypeActivity">

    <com.hjq.bar.TitleBar
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_48"
        android:background="@color/common_transparent_color"
        app:leftIcon="@drawable/arrows_left"
        app:leftIconHeight="@dimen/dp_18"
        app:leftIconWidth="@dimen/dp_18"
        app:lineVisible="false"
        app:titleColor="@color/white"
        app:titleSize="@dimen/sp_16" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0px"
        android:layout_weight="1"
        android:background="@color/common_bg_color"
        android:clickable="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!--        <androidx.appcompat.widget.AppCompatTextView-->
        <!--            android:id="@+id/devices_info"-->
        <!--            android:layout_width="wrap_content"-->
        <!--            android:layout_height="wrap_content"-->
        <!--            android:textColor="#222222"-->
        <!--            android:textSize="@dimen/sp_18" />-->



        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_18"
            android:layout_marginTop="@dimen/dp_15"
            android:layout_marginRight="@dimen/dp_18"
            android:background="@color/white"
            android:orientation="vertical"
            android:paddingLeft="@dimen/dp_12"
            android:paddingRight="@dimen/dp_12">
            <!-- 单选框组 -->
            <RadioGroup
                android:id="@+id/transaction_mode_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 交易模式 1 -->
                <LinearLayout
                    android:id="@+id/ll_mode_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="10dp">

                    <!-- 左侧的文字 -->
                    <TextView
                        android:id="@+id/tv_mode_1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/trans_type_default"
                        android:layout_weight="1"
                        android:gravity="start" />

                    <!-- 右侧的按钮 -->
                    <RadioButton
                        android:checked="true"
                        android:clickable="true"
                        android:id="@+id/rb_mode_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:button="?android:attr/listChoiceIndicatorSingle" />
                </LinearLayout>
                <View
                    style="@style/HorizontalLineStyle2"
                    android:layout_marginTop="@dimen/dp_6" />
                <!-- 交易模式 2 -->
                <LinearLayout
                    android:id="@+id/ll_mode_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="10dp">

                    <!-- 左侧的文字 -->
                    <TextView
                        android:id="@+id/tv_mode_2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/trans_type_savings"
                        android:layout_weight="1"
                        android:gravity="start" />

                    <!-- 右侧的按钮 -->
                    <RadioButton
                        android:clickable="true"
                        android:id="@+id/rb_mode_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:button="?android:attr/listChoiceIndicatorSingle" />
                </LinearLayout>
                <View
                    style="@style/HorizontalLineStyle2"
                    android:layout_marginTop="@dimen/dp_6" />
                <!-- 交易模式 3 -->
                <LinearLayout
                    android:id="@+id/ll_mode_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="10dp">

                    <!-- 左侧的文字 -->
                    <TextView
                        android:id="@+id/tv_mode_3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/trans_type_current"
                        android:layout_weight="1"
                        android:gravity="start" />

                    <!-- 右侧的按钮 -->
                    <RadioButton
                        android:clickable="true"
                        android:id="@+id/rb_mode_3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:button="?android:attr/listChoiceIndicatorSingle" />
                </LinearLayout>
                <View
                    style="@style/HorizontalLineStyle2"
                    android:layout_marginTop="@dimen/dp_6" />
                <!-- 交易模式 4-->
                <LinearLayout
                    android:id="@+id/ll_mode_4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="10dp">

                    <!-- 左侧的文字 -->
                    <TextView
                        android:id="@+id/tv_mode_4"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/trans_type_credit"
                        android:layout_weight="1"
                        android:gravity="start" />

                    <!-- 右侧的按钮 -->
                    <RadioButton
                        android:clickable="true"
                        android:id="@+id/rb_mode_4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:button="?android:attr/listChoiceIndicatorSingle" />
                </LinearLayout>
                <View
                    style="@style/HorizontalLineStyle2"
                    android:layout_marginTop="@dimen/dp_6" />

            </RadioGroup>




        </LinearLayout>

        <LinearLayout
            android:layout_marginTop="20dp"
            android:layout_width="wrap_content"
            android:orientation="vertical"
            android:layout_height="wrap_content">
            <Button
                android:visibility="visible"
                android:textAllCaps="false"
                android:layout_marginBottom="40dp"
                android:layout_alignParentBottom="true"
                android:textSize="16dp"
                android:textColor="#ffffff"
                android:background="@drawable/clors_btn"
                android:layout_centerHorizontal="true"
                android:id="@+id/btn_confirm"
                android:layout_width="188dp"
                android:layout_height="36dp"
                android:text="@string/trans_type_confirm" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>